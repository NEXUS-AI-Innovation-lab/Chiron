# Projet Supabase HÉBERGÉ (supabase.com). Copier ce fichier en .env et le remplir.
# .env est ignoré par git : il contient le mot de passe de la base.
# Sans .env, la pile utilise le Supabase local (`supabase start`).
# Marche à suivre complète : docs/16-supabase.md, §15 « Passer à un projet hébergé ».

# Bouton « Connect » > Direct > Session pooler. Remplacer [YOUR-PASSWORD],
# garder ?sslmode=require. Caractères spéciaux du mot de passe à encoder (@ -> %40).
DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Adresse du projet, vue par le backend (clé publique des jetons).
SUPABASE_URL=https://<ref>.supabase.co
# Émetteur des jetons : l'adresse du projet suivie de /auth/v1.
SUPABASE_JWT_ISSUER=https://<ref>.supabase.co/auth/v1

# Adresse et clé publique, vues par le navigateur (Connect > Framework).
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<cle>
